# Copy to keeper/.env (git-ignored) or set these in your host's dashboard. Never commit real values.
# Runbook: docs/keeper.md. Keep comments on their own lines.

# Fills MODE, CHAIN_ID, FLOOR_ADDRESS, ORACLE_ADDRESS, SWAP_TARGET, SWAP_SPENDER from a deploy.
# Explicit variables below override it.
DEPLOYMENT_FILE=../contracts/deployments/10143.json

# Dedicated provider recommended (QuickNode/Alchemy/Dwellir/Spectrum perks); public RPCs are rate-limited.
RPC_HTTP_URL=https://testnet-rpc.monad.xyz
# Optional: websocket for block/event subscriptions; without it the keeper polls over HTTP.
# RPC_WS_URL=wss://testnet-rpc.monad.xyz

# Dedicated keeper EOA (with or without 0x). Fund above 10 MON: Monad's reserve balance
# caps in-flight gas at min(10 MON, balance).
KEEPER_PRIVATE_KEY=

# Only if not using DEPLOYMENT_FILE:
# MODE=demo
# CHAIN_ID=10143
# FLOOR_ADDRESS=
# ORACLE_ADDRESS=
# SWAP_TARGET=

# Live mode (mainnet): 0x Swap API key from dashboard.0x.org.
# ZEROX_API_KEY=
# ZEROX_API_URL=https://api.0x.org

# Optional (D-004): Pyth Hermes for fresher prices. Without it, sponsored push prices are used.
# HERMES_URL=https://pyth.dourolabs.app/hermes
# HERMES_API_KEY=

# App push notifications (Phase 5): POST target and shared secret (sent as a bearer token).
# NOTIFY_URL=https://your-app.vercel.app/api/notify
# NOTIFY_SECRET=

# Tuning (defaults shown)
# GAS_MULTIPLIER=1.15
# HEALTH_PORT=8787
# POLL_INTERVAL_MS=400
# RESYNC_INTERVAL_MS=30000
# LOW_BALANCE_MON=12
# LOG_LEVEL=info
