# Copy to keeper/.env (git-ignored). Never commit real values.
MODE=demo                      # demo (testnet mocks) | live (mainnet, Pyth + 0x)
CHAIN_ID=10143                 # 10143 testnet | 143 mainnet
RPC_HTTP_URL=                  # dedicated provider (QuickNode/Alchemy/Dwellir/Spectrum); public RPCs are rate-limited
RPC_WS_URL=
KEEPER_PRIVATE_KEY=            # dedicated keeper EOA; fund with >10 MON (Monad reserve balance)
FLOOR_ADDRESS=                 # FloorOrders deployment (Phase 2)
ORACLE_ADDRESS=                # MockOracle (demo) or PythAdapter (live)
ZEROX_API_KEY=                 # live only: dashboard.0x.org
ZEROX_API_URL=https://api.0x.org
HERMES_URL=                    # live only, optional: Pyth Hermes now needs an API key (see docs/DECISIONS.md D-004)
HERMES_API_KEY=
NOTIFY_URL=                    # app's /api/notify (Phase 5)
NOTIFY_SECRET=
GAS_MULTIPLIER=1.15            # Monad charges the gas LIMIT, keep this tight
HEALTH_PORT=8787
LOG_LEVEL=info
