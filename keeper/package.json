{
  "name": "@floor/keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Floor keeper: watches active orders and executes them when the oracle price crosses the trigger",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "e2e:testnet": "tsx --env-file-if-exists=.env scripts/e2e-testnet.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@floor/shared": "workspace:*",
    "pino": "10.4.0",
    "viem": "2.57.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sweep": "./src/sweep.ts",
    "./config": "./src/config.ts",
    "./notifier": "./src/notifier.ts"
  }
}
