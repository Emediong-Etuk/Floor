# Copy to app/.env.local (git-ignored) for local dev; set the same in Vercel's project settings.
# NEXT_PUBLIC_* values are baked into the browser bundle: never put secrets in them.

# --- Public (browser) ---
# Privy app id from dashboard.privy.io (public by design).
NEXT_PUBLIC_PRIVY_APP_ID=
# 10143 = Monad testnet (demo mode). Addresses come from src/lib/deployments.json.
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_DEMO_MODE=true

# Push alerts (Phase 5). Generate a pair once: pnpm --filter @floor/app vapid
# The PUBLIC key goes here; the PRIVATE key goes in VAPID_PRIVATE_KEY below.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: your own WalletConnect Cloud project id, used when people sign in with their own
# wallet from a phone (cloud.reown.com). Privy falls back to its default when empty.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server only (Vercel env, never NEXT_PUBLIC) ---
# MockOracle/MockRouter owner or operator: moves demo prices, mints demo tokens, drips test MON.
DEMO_OPERATOR_PRIVATE_KEY=
# On-demand keeper (D-011). Falls back to DEMO_OPERATOR_PRIVATE_KEY when empty.
KEEPER_PRIVATE_KEY=
# Optional server-side RPC (defaults to NEXT_PUBLIC_RPC_URL).
# RPC_HTTP_URL=

# Push alerts: VAPID private key + a contact (mailto: or https:) for push services.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Where push subscriptions are stored: Upstash Redis (free). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works. Without them, subscriptions
# live in memory and are lost on redeploy (fine for local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret for POST /api/notify (only needed if an always-on keeper posts events here).
NOTIFY_SECRET=
