# Copy to contracts/.env (git-ignored). Never commit real values.
# Dedicated RPCs (QuickNode / Alchemy / Dwellir / Spectrum perks) are preferred over public ones.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# Deployer key: use a fresh throwaway key per network. Never paste a key that holds real funds you can't lose.
DEPLOYER_PRIVATE_KEY=
