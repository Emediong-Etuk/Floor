# Copy to contracts/.env (git-ignored; forge loads it automatically). Never commit real values.
# Runbook: docs/deploy.md. Optional variables are commented out: uncomment to set them.
# Keep comments on their own lines (no trailing "# ..." after a value).

# RPCs. Dedicated providers (QuickNode / Alchemy / Dwellir / Spectrum perks) beat the public ones.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Deployer: a fresh key per network holding only the MON the deploy needs
# (testnet about 3 MON, mainnet about 1.5 MON at 102 gwei; see docs/deploy.md).
DEPLOYER_PRIVATE_KEY=

# DeployDemo (testnet). The /demo panel's server key may move prices and toggle the gap.
# DEMO_OPERATOR_ADDRESS=
# Executor fee in bps (default 10 = 0.1%; contract max 50).
# EXECUTOR_FEE_BPS=10

# DeployLive (mainnet). Per-order USD cap while unaudited (default 500).
# MAX_ORDER_USD=500
# Max oracle age for sponsored Pyth push feeds, seconds (default 3900; 0 = keep 15 s). D-004.
# PUSH_MAX_ORACLE_AGE=3900

# Smoke (post-deploy check). Key defaults to DEPLOYER_PRIVATE_KEY.
# SMOKE_PRIVATE_KEY=
# Mainnet only: MON wrapped to WMON for the create/cancel check, returned afterwards (default 0.1 MON).
# SMOKE_MON_WEI=100000000000000000

# Where deployment JSON is read/written (default deployments/<chainId>.json).
# DEPLOYMENTS_FILE=
